<!-- 帅帅亲子乐园 - 首页 -->
<view class="page">

  <!-- Banner轮播 -->
  <view class="banner-section">
    <swiper class="banner-swiper" indicator-dots indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#D4A574" autoplay circular>
      <swiper-item>
        <view class="banner-item" style="background: linear-gradient(135deg, #FFE4E8 0%, #FFF5F7 100%);">
          <view class="banner-content">
            <text class="banner-title">帅帅亲子乐园</text>
            <text class="banner-subtitle">Joyful Geometry · 快乐几何</text>
            <text class="banner-desc">为孩子打造的安全、温暖、高品质的亲子空间</text>
          </view>
          <view class="banner-decoration">
            <view class="circle circle-1"></view>
            <view class="circle circle-2"></view>
            <view class="circle circle-3"></view>
          </view>
        </view>
      </swiper-item>
      <swiper-item>
        <view class="banner-item" style="background: linear-gradient(135deg, #F5E6D3 0%, #FFE4E8 100%);">
          <view class="banner-content">
            <text class="banner-title">暑期特惠</text>
            <text class="banner-subtitle">Summer Special</text>
            <text class="banner-desc">家庭套票限时8折，欢乐畅玩整个夏天</text>
            <view class="btn btn-primary btn-sm mt-md" bindtap="goToTickets">立即购票</view>
          </view>
          <view class="banner-decoration">
            <view class="circle circle-1"></view>
            <view class="circle circle-2"></view>
          </view>
        </view>
      </swiper-item>
      <swiper-item>
        <view class="banner-item" style="background: linear-gradient(135deg, #FFF5F7 0%, #F5E6D3 100%);">
          <view class="banner-content">
            <text class="banner-title">精彩活动</text>
            <text class="banner-subtitle">Activities</text>
            <text class="banner-desc">每周亲子手工坊、宝宝生日派对等您来</text>
            <view class="btn btn-primary btn-sm mt-md" bindtap="goToActivity">查看活动</view>
          </view>
          <view class="banner-decoration">
            <view class="circle circle-1"></view>
            <view class="circle circle-2"></view>
            <view class="circle circle-3"></view>
          </view>
        </view>
      </swiper-item>
    </swiper>
  </view>

  <!-- 开业预售入口 -->
  <view class="promo-entry" bindtap="goToPromo">
    <view class="promo-entry-bg">
      <view class="promo-entry-circle c1"></view>
      <view class="promo-entry-circle c2"></view>
    </view>
    <view class="promo-entry-content">
      <text class="promo-entry-icon">🎊</text>
      <view class="promo-entry-text">
        <text class="promo-entry-title">开业预售 · 限时特惠</text>
        <text class="promo-entry-desc">498元年卡限前300张 → 点击查看</text>
      </view>
      <text class="promo-entry-arrow">→</text>
    </view>
  </view>

  <!-- 快速入口 -->
  <view class="quick-nav">
    <view class="quick-nav-item" bindtap="goToTickets">
      <view class="quick-nav-icon" style="background: linear-gradient(135deg, #FFB6C1 0%, #FFE4E8 100%);">
        <text class="iconfont icon-ticket"></text>
      </view>
      <text class="quick-nav-text">立即购票</text>
    </view>
    <view class="quick-nav-item" bindtap="goToActivity">
      <view class="quick-nav-icon" style="background: linear-gradient(135deg, #D4A574 0%, #F5E6D3 100%);">
        <text class="iconfont icon-activity"></text>
      </view>
      <text class="quick-nav-text">精彩活动</text>
    </view>
    <view class="quick-nav-item" bindtap="goToMember">
      <view class="quick-nav-icon" style="background: linear-gradient(135deg, #FFE4E8 0%, #F5E6D3 100%);">
        <text class="iconfont icon-member"></text>
      </view>
      <text class="quick-nav-text">会员中心</text>
    </view>
    <view class="quick-nav-item" bindtap="goToGuide">
      <view class="quick-nav-icon" style="background: linear-gradient(135deg, #F5E6D3 0%, #FFE4E8 100%);">
        <text class="iconfont icon-guide"></text>
      </view>
      <text class="quick-nav-text">游玩指南</text>
    </view>
  </view>

  <!-- 乐园信息 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">关于我们</text>
    </view>
    <view class="card card-elevated park-info">
      <view class="park-header">
        <view class="park-logo">
          <text class="logo-text">爱</text>
        </view>
        <view class="park-intro">
          <text class="park-name">帅帅亲子乐园</text>
          <text class="park-slogan">给孩子一个快乐的童年</text>
        </view>
      </view>
      <view class="divider"></view>
      <view class="park-details">
        <view class="park-detail-item">
          <text class="detail-icon">📍</text>
          <text class="detail-text">月球1号基地中心商业区</text>
        </view>
        <view class="park-detail-item">
          <text class="detail-icon">📞</text>
          <text class="detail-text">400-XXX-XXXX</text>
        </view>
        <view class="park-detail-item">
          <text class="detail-icon">🕐</text>
          <text class="detail-text">营业时间：09:00 - 21:00</text>
        </view>
       <view class="park-detail-item">
          <text class="detail-icon">👶</text>
          <text class="detail-text">适龄：0-12岁儿童</text>
        </view>
      </view>
     <view class="btn btn-secondary btn-block mt-md" bindtap="goToGuide">查看详情</view>
    </view>
  </view>

  <!-- 热门活动 -->
  <view class="section">
    <view class="section-header flex-between">
      <text class="section-title">热门活动</text>
      <view class="more-btn" bindtap="goToActivity">
        <text>查看更多</text>
        <text class="arrow">›</text>
      </view>
    </view>
    <view class="activity-list">
      <view class="card activity-card" wx:for="{{activities}}" wx:key="id" bindtap="goToActivityDetail" data-id="{{item.id}}">
        <view class="activity-header">
          <view class="activity-tag tag tag-gold">{{item.date}}</view>
        </view>
        <text class="activity-title">{{item.title}}</text>
        <view class="activity-info">
          <text class="activity-time">🕐 {{item.time}}</text>
          <text class="activity-spots">剩余{{item.spots - item.enrolled}}个名额</text>
        </view>
       <view class="activity-progress">
          <view class="progress-bar">
            <view class="progress-fill" style="width: {{(item.enrolled / item.spots) * 100}}%"></view>
          </view>
          <text class="progress-text">{{item.enrolled}}/{{item.spots}}人已报名</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部留白 -->
  <view style="height: 120rpx;"></view>

  <!-- 隐藏入口：底部小字 -->
  <view class="hidden-entry" bindtap="goToAdmin">
    <text class="hidden-text">管理入口</text>
  </view>

</view>