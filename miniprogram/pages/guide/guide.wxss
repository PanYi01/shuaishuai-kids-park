/* 帅帅亲子乐园 - 游玩指南页面样式 */

/* ==================== 乐园介绍 ==================== */
.intro-section {
  margin-bottom: var(--spacing-lg);
}

.intro-banner {
  position: relative;
}

.banner-bg {
  height: 280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.banner-circles {
  position: absolute;
  width: 100%;
  height: 100%;
}

.circle {
  border-radius: 50%;
  position: absolute;
  background: rgba(212, 165, 116, 0.15);
}

.circle-1 {
  width: 200rpx;
  height: 200rpx;
  right: -50rpx;
  top: -50rpx;
}

.circle-2 {
  width: 150rpx;
  height: 150rpx;
  left: -30rpx;
  bottom: -30rpx;
  background: rgba(255, 182, 193, 0.15);
}

.banner-content {
  text-align: center;
  z-index: 2;
}

.banner-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--gray-text);
  margin-bottom: var(--spacing-xs);
}

.banner-subtitle {
  display: block;
  font-size: 28rpx;
  color: var(--gold-accent);
}

.intro-desc {
  padding: var(--spacing-lg);
  background: var(--white-pure);
}

.desc-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

/* ==================== 乐园分区 ==================== */
.zone-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--spacing-md);
  padding: 0 var(--spacing-md);
}

.zone-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-md);
  background: var(--white-pure);
  border-radius: var(--radius-lg);
}

.zone-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--spacing-sm);
}

.zone-icon text {
  font-size: 50rpx;
}

.zone-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--gray-text);
  margin-bottom: 4rpx;
}

.zone-age {
  font-size: 22rpx;
  color: #999;
}

/* ==================== 游玩须知 ==================== */
.notice-item {
  display: flex;
  align-items: flex-start;
  padding: var(--spacing-sm) 0;
}

.notice-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-md);
  background: var(--pink-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: var(--spacing-md);
  flex-shrink: 0;
}

.notice-icon text {
  font-size: 32rpx;
}

.notice-content {
  flex: 1;
}

.notice-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--gray-text);
  margin-bottom: 4rpx;
}

.notice-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

/* ==================== 营业时间 ==================== */
.time-header {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-md);
}

.time-icon {
  font-size: 36rpx;
  margin-right: var(--spacing-sm);
}

.time-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--gray-text);
}

.time-grid {
  display: flex;
  flex-direction: column;
}

.time-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-sm) 0;
}

.time-label {
  font-size: 28rpx;
  color: #666;
}

.time-value {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--gray-text);
}

.time-tip {
  display: flex;
  align-items: flex-start;
  background: var(--white-pure);
  padding: var(--spacing-sm) var(--spacing-md);
  border-radius: var(--radius-md);
}

.tip-icon {
  font-size: 28rpx;
  margin-right: var(--spacing-sm);
}

.tip-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--gold-accent);
  line-height: 1.5;
}

/* ==================== 交通指南 ==================== */
.location-item {
  display: flex;
  align-items: center;
}

.location-icon {
  font-size: 36rpx;
  margin-right: var(--spacing-md);
}

.location-info {
  flex: 1;
}

.location-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--gray-text);
  margin-bottom: 4rpx;
}

.location-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
}

.location-action {
  background: var(--gold-accent);
  color: var(--white-pure);
  padding: 12rpx 24rpx;
  border-radius: var(--radius-full);
  font-size: 26rpx;
}

.transport-item {
  display: flex;
  align-items: flex-start;
}

.transport-icon {
  font-size: 36rpx;
  margin-right: var(--spacing-md);
}

.transport-info {
  flex: 1;
}

.transport-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--gray-text);
  margin-bottom: 4rpx;
}

.transport-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

/* ==================== 联系我们 ==================== */
.contact-item {
  display: flex;
  align-items: center;
}

.contact-icon {
  font-size: 36rpx;
  margin-right: var(--spacing-md);
}

.contact-info {
  flex: 1;
}

.contact-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--gray-text);
  margin-bottom: 4rpx;
}

.contact-value {
  display: block;
  font-size: 26rpx;
  color: #666;
}

.contact-arrow {
  font-size: 36rpx;
  color: #ccc;
}

/* ==================== 页面样式 ==================== */
.page {
  min-height: 100vh;
  background: var(--pink-light);
}