/* 帅帅亲子乐园 - 会员中心样式 */

/* ==================== 用户信息头部 ==================== */
.member-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-lg);
  background: linear-gradient(135deg, var(--pink-light) 0%, var(--gold-light) 100%);
}

.user-info {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid var(--white-pure);
  box-shadow: var(--shadow-soft);
  margin-right: var(--spacing-md);
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.user-detail {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--gray-text);
  margin-bottom: 8rpx;
}

.user-phone {
  font-size: 26rpx;
  color: #666;
}

.user-desc {
  font-size: 24rpx;
  color: #999;
}

.member-level {
  display: flex;
}

.level-badge {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, var(--gold-accent) 0%, #C49458 100%);
  padding: 8rpx 20rpx;
  border-radius: var(--radius-full);
}

.level-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.level-name {
  font-size: 24rpx;
  color: var(--white-pure);
  font-weight: 600;
}

/* ==================== 会员卡 ==================== */
.member-card-section {
  margin: var(--spacing-md);
  margin-top: -60rpx;
  position: relative;
  z-index: 10;
}

.member-card {
  border-radius: var(--radius-xl);
  padding: var(--spacing-lg);
  position: relative;
  overflow: hidden;
  min-height: 300rpx;
  display: flex;
  flex-direction: column;
  transition: all 0.3s ease;
}

.member-card.inactive {
  background: linear-gradient(135deg, var(--pink-light) 0%, var(--gold-light) 100%);
  box-shadow: var(--shadow-soft);
}

.member-card.active {
  background: linear-gradient(135deg, var(--gold-accent) 0%, #C49458 100%);
  box-shadow: var(--shadow-gold);
}

.card-decoration {
  position: absolute;
  right: -80rpx;
  top: -80rpx;
}

.deco-circle {
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  position: absolute;
}

.deco-1 {
  width: 300rpx;
  height: 300rpx;
  right: -50rpx;
  top: -50rpx;
}

.deco-2 {
  width: 200rpx;
  height: 200rpx;
  right: 50rpx;
  top: 50rpx;
  background: rgba(255, 255, 255, 0.05);
}

.card-content {
  flex: 1;
  z-index: 2;
  position: relative;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-lg);
}

.card-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--white-pure);
}

.card-brand {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: 2rpx;
}

.card-body {
  flex: 1;
}

.card-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-sm) 0;
}

.info-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.info-value {
  font-size: 28rpx;
  color: var(--white-pure);
  font-weight: 500;
}

.info-value.gold {
  color: #FFE566;
}

.card-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.6;
}

.card-footer {
  margin-top: var(--spacing-md);
}

.valid-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* ==================== 功能菜单 ==================== */
.menu-section {
  padding: var(--spacing-md);
}

.menu-group {
  background: var(--white-pure);
  border-radius: var(--radius-lg);
  margin-bottom: var(--spacing-md);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-md) var(--spacing-lg);
  border-bottom: 1rpx solid var(--gray-border);
  transition: background 0.2s;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: var(--pink-light);
}

.menu-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: var(--spacing-md);
}

.menu-icon text {
  font-size: 36rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--gray-text);
}

.menu-badge {
  background: var(--pink-main);
  color: var(--white-pure);
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
  margin-right: var(--spacing-sm);
}

.menu-arrow {
  font-size: 32rpx;
  color: #ccc;
}

/* ==================== 页面样式 ==================== */
.page {
  min-height: 100vh;
  background: var(--pink-light);
}