<!-- 帅帅亲子乐园 - 员工工作台 -->
<view class="page">

  <!-- 员工信息头部 -->
  <view class="header-section">
    <view class="user-info">
      <view class="user-avatar">
        <text class="avatar-icon">👨‍💼</text>
      </view>
      <view class="user-detail">
        <text class="user-name">{{adminInfo.name}}</text>
        <text class="user-role">员工编号：{{adminInfo.employeeId}}</text>
      </view>
    </view>
    <view class="header-time">
      <text class="date-text">{{currentDate}}</text>
      <text class="time-text">{{currentTime}}</text>
    </view>
  </view>

  <!-- 今日统计 -->
  <view class="stats-section">
    <view class="stat-card">
      <text class="stat-value">{{todayStats.verified}}</text>
      <text class="stat-label">今日核销</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{todayStats.tickets}}</text>
      <text class="stat-label">售出票</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">¥{{todayStats.revenue}}</text>
      <text class="stat-label">营业额</text>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="menu-section">
    <view class="menu-title">工作功能</view>
    <view class="menu-grid">
      <view class="menu-item" bindtap="goToVerify">
        <view class="menu-icon" style="background: linear-gradient(135deg, #FFB6C1 0%, #FFE4E8 100%);">
          <text>🎫</text>
        </view>
        <text class="menu-text">核销验证</text>
        <text class="menu-badge" wx:if="{{pendingVerify > 0}}">{{pendingVerify}}</text>
      </view>
      <view class="menu-item" bindtap="goToDailyReport">
        <view class="menu-icon" style="background: linear-gradient(135deg, #D4A574 0%, #F5E6D3 100%);">
          <text>📊</text>
        </view>
        <text class="menu-text">提交日报</text>
      </view>
      <view class="menu-item" bindtap="reportSpecial">
        <view class="menu-icon" style="background: linear-gradient(135deg, #FF6B6B 0%, #FFB4B4 100%);">
          <text>⚠️</text>
        </view>
        <text class="menu-text">特殊情况</text>
      </view>
      <view class="menu-item" bindtap="logout">
        <view class="menu-icon" style="background: linear-gradient(135deg, #E8E8E8 0%, #F8F8F8 100%);">
         <text>🚪</text>
        </view>
        <text class="menu-text">退出登录</text>
      </view>
    </view>
  </view>

  <!-- 最近核销记录 -->
  <view class="records-section">
    <view class="section-header">
      <text class="section-title">最近核销记录</text>
      <text class="more-btn" bindtap="viewAllRecords">查看全部 ›</text>
    </view>
    <view class="record-list">
      <view class="record-item" wx:for="{{recentRecords}}" wx:key="id">
        <view class="record-left">
          <text class="record-platform {{item.platform}}">{{item.platform === 'douyin' ? '抖音' : '点评'}}</text>
          <text class="record-code">{{item.code}}</text>
        </view>
        <view class="record-right">
          <text class="record-status {{item.status}}">{{item.status === 'success' ? '已核销' : '待处理'}}</text>
          <text class="record-time">{{item.time}}</text>
        </view>
      </view>
      <view class="empty-record" wx:if="{{recentRecords.length === 0}}">
        <text>暂无核销记录</text>
      </view>
    </view>
  </view>

</view>