/* 帅帅亲子乐园 - 员工工作台样式 */

.page {
  min-height: 100vh;
  background: var(--pink-light);
}

/* 头部信息 */
.header-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-lg);
  background: linear-gradient(135deg, var(--gold-accent) 0%, #C49458 100%);
}

.user-info {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: var(--spacing-md);
}

.avatar-icon {
  font-size: 48rpx;
}

.user-name {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--white-pure);
  margin-bottom: 4rpx;
}

.user-role {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.header-time {
  text-align: right;
}

.date-text {
  display: block;
  font-size: 28rpx;
  color: var(--white-pure);
  margin-bottom: 4rpx;
}

.time-text {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--white-pure);
}

/* 今日统计 */
.stats-section {
  display: flex;
  padding: var(--spacing-md);
  margin-top: -40rpx;
}

.stat-card {
  flex: 1;
  background: var(--white-pure);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin: 0 var(--spacing-xs);
  text-align: center;
  box-shadow: var(--shadow-soft);
}

.stat-value {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--gold-accent);
  margin-bottom: 8rpx;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #999;
}

/* 功能菜单 */
.menu-section {
  padding: var(--spacing-md);
}

.menu-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--gray-text);
  margin-bottom: var(--spacing-md);
  padding-left: var(--spacing-sm);
  border-left: 4rpx solid var(--gold-accent);
}

.menu-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--spacing-md);
}

.menu-item {
  position: relative;
  background: var(--white-pure);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--shadow-soft);
}

.menu-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--spacing-sm);
}

.menu-icon text {
  font-size: 48rpx;
}

.menu-text {
  font-size: 28rpx;
  color: var(--gray-text);
  font-weight: 500;
}

.menu-badge {
  position: absolute;
  top: var(--spacing-sm);
  right: var(--spacing-sm);
  background: var(--pink-main);
  color: var(--white-pure);
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
}

/* 核销记录 */
.records-section {
  padding: var(--spacing-md);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-md);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--gray-text);
  padding-left: var(--spacing-sm);
  border-left: 4rpx solid var(--gold-accent);
}

.more-btn {
  font-size: 26rpx;
  color: var(--gold-accent);
}

.record-list {
  background: var(--white-pure);
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-md);
  border-bottom: 1rpx solid var(--gray-border);
}

.record-item:last-child {
  border-bottom: none;
}

.record-left {
  display: flex;
  align-items: center;
}

.record-platform {
  background: var(--gold-light);
  color: var(--gold-accent);
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
  margin-right: var(--spacing-sm);
}

.record-platform.douyin {
  background: #1C1C1C;
  color: var(--white-pure);
}

.record-platform.dianping {
  background: #FF6633;
  color: var(--white-pure);
}

.record-code {
  font-size: 28rpx;
  color: var(--gray-text);
}

.record-right {
  text-align: right;
}

.record-status {
  display: block;
  font-size: 24rpx;
  margin-bottom: 4rpx;
}

.record-status.success {
  color: var(--gold-accent);
}

.record-time {
  display: block;
  font-size: 22rpx;
  color: #999;
}

.empty-record {
  padding: var(--spacing-xl);
  text-align: center;
  color: #999;
  font-size: 28rpx;
}