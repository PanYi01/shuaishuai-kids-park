/* 帅帅亲子乐园 - Joyful Geometry 设计风格全局样式 */

/* ==================== 基础变量 ==================== */
:root {
  /* 核心色彩 - Joyful Geometry 调色板 */
  --pink-warm: #FFE4E8;        /* 温暖粉 */
  --pink-light: #FFF5F7; /* 浅粉白 */
  --pink-main: #FFB6C1;        /* 主粉 */
  --gold-accent: #D4A574;      /* 金色点缀 */
  --gold-light: #F5E6D3;       /* 浅金色 */
  --white-pure: #FFFFFF;       /* 纯白 */
  --gray-text: #4A4A4A;       /* 正文灰 */
  --gray-light: #F8F8F8;       /* 浅灰背景 */
  --gray-border: #E8E8E8;      /* 边框灰 */

  /* 圆角系统 */
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-xl: 48rpx;
  --radius-full: 999rpx;

  /* 阴影系统 */
  --shadow-soft: 0 4rpx 20rpx rgba(212, 165, 116, 0.1);
  --shadow-medium: 0 8rpx 30rpx rgba(212, 165, 116, 0.15);
  --shadow-gold: 0 0 20rpx rgba(212, 165, 116, 0.2);

  /* 间距系统 */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;
  --spacing-xxl: 64rpx;
}

/* ==================== 基础重置 ==================== */
page {
  background: var(--white-pure);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  color: var(--gray-text);
  font-size: 28rpx;
  line-height: 1.6;
}

/* ==================== 通用容器 ==================== */
.container {
  min-height: 100vh;
  padding: var(--spacing-md);
  box-sizing: border-box;
}

.section {
  margin-bottom: var(--spacing-lg);
}

.section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--gray-text);
  margin-bottom: var(--spacing-md);
  padding-left: var(--spacing-sm);
  border-left: 4rpx solid var(--gold-accent);
}

/* ==================== 卡片组件 ==================== */
.card {
  background: var(--white-pure);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-soft);
}

.card-elevated {
  background: var(--white-pure);
  border-radius: var(--radius-xl);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-medium);
}

.card-gold {
  background: linear-gradient(135deg, var(--white-pure) 0%, var(--gold-light) 100%);
  border-radius: var(--radius-xl);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-gold);
  border: 1rpx solid var(--gold-accent);
}

/* ==================== 按钮系统 ==================== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  font-size: 30rpx;
  font-weight: 500;
  padding: 24rpx 48rpx;
  transition: all 0.3s ease;
  border: none;
  outline: none;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, var(--gold-accent) 0%, #C49458100%);
  color: var(--white-pure);
  box-shadow: var(--shadow-soft);
}

.btn-primary:active {
  transform: scale(0.98);
  box-shadow: none;
}

.btn-secondary {
  background: var(--pink-light);
  color: var(--gray-text);
  border: 2rpx solid var(--pink-main);
}

.btn-secondary:active {
  background: var(--pink-warm);
}

.btn-ghost {
  background: transparent;
  color: var(--gold-accent);
}

.btn-block {
  width: 100%;
}

.btn-sm {
  padding: 16rpx 32rpx;
  font-size: 26rpx;
}

/* ==================== 标签系统 ==================== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-full);
  font-size: 22rpx;
}

.tag-gold {
  background: var(--gold-light);
  color: var(--gold-accent);
}

.tag-pink {
  background: var(--pink-warm);
  color: var(--pink-main);
}

/* ==================== 输入框 ==================== */
.input {
  width: 100%;
  padding: 24rpx;
  border: 2rpx solid var(--gray-border);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  background: var(--white-pure);
  transition: border-color 0.3s;
}

.input:focus {
  border-color: var(--gold-accent);
}

.input-pink {
  border-color: var(--pink-main);
  background: var(--pink-light);
}

/* ==================== 图片 ==================== */
image {
  width: 100%;
  display: block;
}

.img-rounded {
  border-radius: var(--radius-lg);
  overflow: hidden;
}

/* ==================== Flex工具类 ==================== */
.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

/* ==================== 文本工具类 ==================== */
.text-center {
  text-align: center;
}

.text-gold {
  color: var(--gold-accent);
}

.text-pink {
  color: var(--pink-main);
}

.text-bold {
  font-weight: 600;
}

.text-lg {
  font-size: 36rpx;
}

.text-xl {
  font-size: 48rpx;
}

.text-sm {
  font-size: 24rpx;
}

/* ==================== 间距工具类 ==================== */
.mt-sm { margin-top: var(--spacing-sm); }
.mt-md { margin-top: var(--spacing-md); }
.mt-lg { margin-top: var(--spacing-lg); }
.mb-sm { margin-bottom: var(--spacing-sm); }
.mb-md { margin-bottom: var(--spacing-md); }
.mb-lg { margin-bottom: var(--spacing-lg); }
.p-sm { padding: var(--spacing-sm); }
.p-md { padding: var(--spacing-md); }
.p-lg { padding: var(--spacing-lg); }

/* ==================== 空状态 ==================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xxl);
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: var(--spacing-md);
  opacity: 0.5;
}

.empty-text {
  color: #999;
  font-size: 28rpx;
}

/* ==================== 加载状态 ==================== */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xl);
}

.loading-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--gold-accent);
  margin: 0 8rpx;
  animation: loadingFade 1.4s ease-in-out infinite;
}

.loading-dot:nth-child(2) { animation-delay: 0.2s; }
.loading-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes loadingFade {
  0%, 80%, 100% { opacity: 0.3; transform: scale(0.8); }
  40% { opacity: 1; transform: scale(1); }
}

/* ==================== 价格展示 ==================== */
.price {
  color: var(--gold-accent);
  font-weight: 600;
}

.price-symbol {
  font-size: 24rpx;
}

.price-value {
  font-size: 40rpx;
}

.price-original {
  text-decoration: line-through;
  color: #999;
  font-size: 24rpx;
  margin-left: var(--spacing-xs);
}

/* ==================== 分隔线 ==================== */
.divider {
  height: 1rpx;
  background: var(--gray-border);
  margin: var(--spacing-md) 0;
}

.divider-gold {
  height: 2rpx;
  background: linear-gradient(90deg, transparent, var(--gold-accent), transparent);
  margin: var(--spacing-md) 0;
}