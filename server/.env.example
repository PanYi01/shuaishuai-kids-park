# ============================================
#  帅帅亲子乐园 · 小程序后端配置文件
#  改店名只需要改下面三行，其他不用动
# ============================================

# ── 你的乐园信息（只改这里！） ──
PARK_NAME=帅帅亲子乐园
PARK_ADDRESS=月球1号基地中心商业区
PARK_PHONE=400-XXX-XXXX

# ── 微信小程序凭证（去 mp.weixin.qq.com 拿） ──
WX_APPID=wx_your_appid_here
WX_SECRET=your_app_secret_here

# ── 微信支付商户号（去 pay.weixin.qq.com 拿） ──
WXPAY_MCHID=你的商户号
WXPAY_API_KEY=你的APIv3密钥
WXPAY_SERIAL_NO=你的证书序列号
WXPAY_NOTIFY_URL=https://你的域名.com/api/orders/notify

# ── 服务器配置 ──
PORT=3000
JWT_SECRET=改成一个随机字符串越乱越好
ADMIN_PASSWORD=admin888

# ── 环境 ──
NODE_ENV=production
