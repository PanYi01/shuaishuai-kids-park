{
  "name": "shuaishuai-kids-park-server",
  "version": "1.0.0",
  "description": "帅帅亲子乐园 · 小程序后端服务 | 改个店名就能用",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
